generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id               String   @id @default(cuid())
  name             String?
  email            String   @unique
  emailVerified    DateTime?
  image            String?
  password         String?
  timezone         String   @default("UTC")
  locale           String   @default("en")
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  accounts          Account[]
  sessions          Session[]
  memberships       Membership[]
  ownedProjects     Project[]            @relation("ProjectLead")
  reportedIssues    Issue[]              @relation("IssueReporter")
  assignedIssues    Issue[]              @relation("IssueAssignee")
  comments          Comment[]
  watchedIssues     IssueWatcher[]
  attachments       Attachment[]
  documents         Document[]
  messages          Message[]
  messageReactions  MessageReaction[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  deployments       Deployment[]
  apiKeys           ApiKey[]
  sentInvitations   Invitation[]         @relation("InvitationSender")
  channelMemberships ChannelMember[]
  createdChannels   Channel[]            @relation("ChannelCreator")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  logo         String?
  description  String?
  plan         String   @default("free")
  billingEmail String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teams        Team[]
  memberships  Membership[]
  roles        Role[]
  projects     Project[]
  channels     Channel[]
  notifications Notification[]
  auditLogs    AuditLog[]
  apiKeys      ApiKey[]
  webhooks     Webhook[]
  invitations  Invitation[]

  @@map("organizations")
}

model Team {
  id             String @id @default(cuid())
  name           String
  description    String?
  organizationId String

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitations   Invitation[]

  @@map("teams")
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  roleId         String
  joinedAt       DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([userId, organizationId])
  @@map("memberships")
}

model Role {
  id             String  @id @default(cuid())
  name           String
  description    String?
  organizationId String
  isSystem       Boolean @default(false)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships     Membership[]
  rolePermissions RolePermission[]
  invitations     Invitation[]

  @@unique([name, organizationId])
  @@map("roles")
}

model Permission {
  id          String @id @default(cuid())
  action      String @unique
  description String?
  category    String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Project {
  id             String   @id @default(cuid())
  name           String
  slug           String
  description    String?
  icon           String?
  organizationId String
  leadId         String?
  startDate      DateTime?
  endDate        DateTime?
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         User?        @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  sprints      Sprint[]
  issues       Issue[]
  labels       Label[]
  documents    Document[]
  deployments  Deployment[]

  @@unique([organizationId, slug])
  @@map("projects")
}

model Sprint {
  id        String   @id @default(cuid())
  title     String
  goal      String?
  projectId String
  status    String   @default("planning")
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@map("sprints")
}

model Issue {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("backlog")
  priority    String   @default("medium")
  type        String   @default("task")
  projectId   String
  sprintId    String?
  reporterId  String
  assigneeId  String?
  parentId    String?
  dueDate     DateTime?
  estimate    Int?
  sortOrder   Float    @default(0)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint      Sprint?      @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  reporter    User         @relation("IssueReporter", fields: [reporterId], references: [id])
  assignee    User?        @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  parent      Issue?       @relation("IssueChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children    Issue[]      @relation("IssueChildren")
  comments    Comment[]
  labels      IssueLabel[]
  checklists  ChecklistItem[]
  watchers    IssueWatcher[]
  attachments Attachment[]

  @@index([projectId, status])
  @@index([projectId, sprintId])
  @@index([assigneeId])
  @@map("issues")
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  issueId   String
  userId    String
  parentId  String?
  isEdited  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issue    Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies  Comment[] @relation("CommentReplies")
  attachments Attachment[]

  @@map("comments")
}

model Label {
  id        String @id @default(cuid())
  name      String
  color     String @default("#6366f1")
  projectId String

  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issueLinks IssueLabel[]

  @@unique([name, projectId])
  @@map("labels")
}

model IssueLabel {
  id      String @id @default(cuid())
  issueId String
  labelId String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([issueId, labelId])
  @@map("issue_labels")
}

model ChecklistItem {
  id        String  @id @default(cuid())
  title     String
  isChecked Boolean @default(false)
  issueId   String
  sortOrder Float   @default(0)

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@map("checklist_items")
}

model IssueWatcher {
  id      String @id @default(cuid())
  issueId String
  userId  String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issueId, userId])
  @@map("issue_watchers")
}

model Attachment {
  id        String   @id @default(cuid())
  fileName  String
  fileSize  Int
  mimeType  String
  url       String
  key       String
  issueId   String?
  commentId String?
  userId    String
  createdAt DateTime @default(now())

  issue   Issue?   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model Document {
  id          String   @id @default(cuid())
  title       String
  content     String   @default("")
  projectId   String
  parentId    String?
  userId      String
  isPublished Boolean  @default(false)
  sortOrder   Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   Document? @relation("DocumentChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children Document[] @relation("DocumentChildren")
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model Channel {
  id               String   @id @default(cuid())
  name             String
  topic            String?
  description      String?
  organizationId   String
  isPrivate        Boolean  @default(false)
  isDirectMessage  Boolean  @default(false)
  createdById      String?
  createdAt        DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation("ChannelCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members      ChannelMember[]
  messages     Message[]

  @@unique([organizationId, name])
  @@map("channels")
}

model ChannelMember {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  joinedAt  DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@map("channel_members")
}

model Message {
  id        String   @id @default(cuid())
  content   String
  channelId String
  userId    String
  parentId  String?
  isEdited  Boolean  @default(false)
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channel  Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Message?         @relation("MessageReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies  Message[]        @relation("MessageReplies")
  reactions MessageReaction[]

  @@index([channelId, createdAt])
  @@map("messages")
}

model MessageReaction {
  id        String @id @default(cuid())
  messageId String
  userId    String
  emoji     String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@map("message_reactions")
}

model Notification {
  id             String   @id @default(cuid())
  type           String
  title          String
  body           String?
  userId         String
  organizationId String?
  referenceId    String?
  referenceType  String?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id             String   @id @default(cuid())
  action         String
  entityType     String
  entityId       String
  userId         String
  organizationId String?
  metadata       String?
  ipAddress      String?
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

model Deployment {
  id            String    @id @default(cuid())
  projectId     String
  environment   String    @default("production")
  status        String    @default("pending")
  commitSha     String?
  commitMessage String?
  branch        String?
  deployedById  String
  url           String?
  logs          String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deployedBy User   @relation(fields: [deployedById], references: [id])

  @@index([projectId, createdAt])
  @@map("deployments")
}

model ApiKey {
  id           String    @id @default(cuid())
  name         String
  key          String    @unique
  organizationId String
  userId       String
  permissions  String?
  lastUsedAt   DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model Webhook {
  id              String    @id @default(cuid())
  url             String
  secret          String?
  organizationId  String
  events          String
  isActive        Boolean   @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("webhooks")
}

model Invitation {
  id             String   @id @default(cuid())
  email          String
  token          String   @unique
  organizationId String
  teamId         String?
  roleId         String?
  invitedById    String
  status         String   @default("pending")
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  role         Role?        @relation(fields: [roleId], references: [id], onDelete: SetNull)
  invitedBy    User         @relation("InvitationSender", fields: [invitedById], references: [id])

  @@index([email, status])
  @@map("invitations")
}
